# Public, browser-exposed configuration only. Never put secrets, API keys or
# provider tokens in VITE_-prefixed variables: anything with this prefix is
# inlined into the client bundle.

# Base path the frontend uses for API calls. Relative by default so the
# frontend and API can be served from the same origin in production. Must
# stay under /api so the Vite dev-server proxy (see vite.config.ts) and
# same-origin production deploys both route it to the backend.
VITE_DEVMATE_API_BASE_URL=/api/v1

# When "true", the app boots the MSW mock service worker instead of talking
# to a real backend. Never set this in a production build.
VITE_ENABLE_MOCKS=true

# Informational build identifier surfaced in the diagnostics screen.
VITE_BUILD_SHA=local

# Node-only (not exposed to the browser): where the Vite dev server proxies
# /api requests to. Read in vite.config.ts, not in application code.
DEVMATE_API_PROXY_TARGET=http://127.0.0.1:8000

# Cortana is a separate local agent-runner service (not proxied, not mocked
# by MSW) that the frontend talks to directly at a fixed loopback address.
# This override only takes effect in dev builds (import.meta.env.DEV) — a
# production build always targets http://127.0.0.1:8765, since Cortana is
# inherently a local-only service and must never be pointed at a remote host.
# Leave unset to use that default.
VITE_CORTANA_API_BASE_URL=http://127.0.0.1:8765
