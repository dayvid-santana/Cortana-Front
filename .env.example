# Public, browser-exposed configuration only. Never put secrets, API keys or
# provider tokens in VITE_-prefixed variables: anything with this prefix is
# inlined into the client bundle.

# Base path the frontend uses for API calls. Relative by default so the
# frontend and API can be served from the same origin in production.
VITE_DEVMATE_API_BASE_URL=/api

# When "true", the app boots the MSW mock service worker instead of talking
# to a real backend. Never set this in a production build.
VITE_ENABLE_MOCKS=true

# Informational build identifier surfaced in the diagnostics screen.
VITE_BUILD_SHA=local

# Node-only (not exposed to the browser): where the Vite dev server proxies
# /api requests to. Read in vite.config.ts, not in application code.
DEVMATE_API_PROXY_TARGET=http://127.0.0.1:8000
