# Loaded automatically by Vitest (mode "test"). Node's fetch (unlike a real
# browser) has no implicit page origin to resolve relative URLs against, so
# tests need an absolute API base URL. MSW intercepts these regardless of
# host/port. Not used by `npm run dev`/`build`, which use `.env`/`.env.local`.
VITE_DEVMATE_API_BASE_URL=http://localhost/api/v1
