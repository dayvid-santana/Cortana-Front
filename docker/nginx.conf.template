server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # gzip the text-ish assets Vite emits (JS/CSS chunks, the HTML shell).
    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Hashed asset filenames (Vite's default) can be cached forever.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Same-origin API proxy, matching the Vite dev-server proxy in
    # vite.config.ts: the /api prefix is forwarded as-is (no rewrite), so a
    # request to /api/v1/health reaches the backend at /api/v1/health.
    #
    # The target is resolved lazily (per-request, via a variable) rather
    # than once at startup: with no backend defined by default (see
    # docs/web-api-gaps.md), a static proxy_pass would fail DNS resolution
    # at config-load time and crash-loop nginx before it ever serves the
    # SPA. 127.0.0.11 is Docker's embedded DNS server, available on any
    # Compose-managed network.
    resolver 127.0.0.11 valid=10s ipv6=off;
    location /api/ {
        set $devmate_api_upstream "${DEVMATE_API_PROXY_TARGET}";
        proxy_pass $devmate_api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA fallback: unknown paths resolve client-side via TanStack Router.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
