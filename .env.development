# Loaded automatically by Vite for `npm run dev` (and by Playwright's
# webServer, which just runs `npm run dev`). No real DevMate backend exists
# yet — see docs/web-api-gaps.md — so local development defaults to the MSW
# mocks. Once a real backend is available, override with a local, gitignored
# `.env.development.local` setting VITE_ENABLE_MOCKS=false.
VITE_ENABLE_MOCKS=true
